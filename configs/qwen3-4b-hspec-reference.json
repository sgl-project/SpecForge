{
  "_notes": [
    "H-Spec reference draft config translated from the official speculators",
    "checkpoint (weifanjiang/H-Spec, mamba_attn_hybrid over Qwen3-4B).",
    "attn_kv_layer_ids / latent_fusion_layer_ids / block_pattern follow the",
    "official semantics: 3 mamba+attention hybrid layers borrow target K/V",
    "from layers 17/25/34 and fuse latents from layers 1/9/17/25/34.",
    "hspec_config.mamba_backend='reference' is the correctness-first SpecForge",
    "recurrence; unlike earlier revisions it does not require hidden_size ==",
    "mamba_num_heads * mamba_head_dim, so the official 44*64 mapping (2816",
    "inner width vs hidden_size 2560) instantiates directly, with the mixer's",
    "out_proj mapping back to the hidden size as on the serving side.",
    "Note: training derives num_hidden_layers from block_pattern length (all",
    "sub-layers), while the serving side requires num_hidden_layers == number",
    "of attention sub-layers; serving deployments need that field adjusted."
  ],
  "architectures": ["HSpecDraftModel"],
  "attention_bias": false,
  "attention_dropout": 0.0,
  "auto_map": {"AutoModel": "hspec.HSpecDraftModel"},
  "block_size": 8,
  "bos_token_id": 151643,
  "dflash_config": {
    "confidence_head_alpha": 1.0,
    "confidence_head_with_markov": true,
    "enable_confidence_head": true,
    "markov_head_type": "vanilla",
    "markov_rank": 256,
    "projector_type": "dspark",
    "target_layer_ids": [1, 9, 17, 25, 34]
  },
  "dtype": "bfloat16",
  "eos_token_id": 151645,
  "head_dim": 128,
  "hidden_act": "silu",
  "hidden_size": 2560,
  "initializer_range": 0.02,
  "intermediate_size": 9728,
  "layer_types": [
    "full_attention",
    "full_attention",
    "full_attention",
    "full_attention",
    "full_attention",
    "full_attention",
    "full_attention",
    "full_attention",
    "full_attention",
    "full_attention",
    "full_attention"
  ],
  "max_position_embeddings": 40960,
  "model_type": "qwen3",
  "num_attention_heads": 32,
  "num_hidden_layers": 11,
  "num_key_value_heads": 8,
  "num_target_layers": 36,
  "rms_norm_eps": 1e-06,
  "rope_parameters": {
    "rope_theta": 1000000,
    "rope_type": "default"
  },
  "sliding_window": null,
  "tie_word_embeddings": false,
  "use_cache": true,
  "vocab_size": 151936,
  "hspec_config": {
    "attn_kv_layer_ids": [17, 25, 34],
    "block_pattern": [
      "mamba",
      "mlp",
      "mamba",
      "attention",
      "mlp",
      "mamba",
      "attention",
      "mlp",
      "mamba",
      "attention",
      "mlp"
    ],
    "debug_only": false,
    "latent_fusion_layer_ids": [1, 9, 17, 25, 34],
    "mamba_backend": "reference",
    "mamba_conv_kernel": 4,
    "mamba_groups": 4,
    "mamba_head_dim": 64,
    "mamba_num_heads": 44,
    "mamba_state_size": 4,
    "target_kv_layer_ids": [17, 25, 34]
  }
}
