    ],
    "debug_only": true,
    "latent_fusion_layer_ids": [1, 9, 17, 25, 34],
    "mamba_backend": "reference",
    "mamba_conv_kernel": 4,
    "mamba_groups": 4,
    "mamba_head_dim": 64,
    "mamba_num_heads": 40,
    "mamba_state_size": 4,
    "target_kv_layer_ids": [17]
