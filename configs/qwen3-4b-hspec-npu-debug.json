{
  "_notes": [
    "DEBUG-ONLY NPU smoke config. block_pattern is truncated to a single",
    "mamba+attention pair to keep Ascend smoke runs fast; it is NOT the",
    "official H-Spec topology and must never train a final checkpoint.",
    "Use configs/qwen3-4b-hspec-reference.json for real training runs.",
    "mamba_num_heads=40 keeps hidden_size == mamba_num_heads * mamba_head_dim",
    "so the reference mamba backend can instantiate."
  ],
  "architectures": ["HSpecDraftModel"],
  "attention_bias": false,
  "attention_dropout": 0.0,
  "auto_map": {"AutoModel": "hspec.HSpecDraftModel"},
  "block_size": 8,
  "bos_token_id": 151643,
  "dflash_config": {
    "confidence_head_alpha": 1.0,
    "confidence_head_with_markov": true,
    "enable_confidence_head": true,
    "markov_head_type": "vanilla",
    "markov_rank": 256,
    "projector_type": "dspark",
    "target_layer_ids": [1, 9, 17, 25, 33]
  },
  "dtype": "bfloat16",
  "eos_token_id": 151645,
  "head_dim": 128,
  "hidden_act": "silu",
