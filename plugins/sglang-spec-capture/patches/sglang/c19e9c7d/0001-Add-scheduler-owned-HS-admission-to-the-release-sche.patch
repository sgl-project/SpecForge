+"""Scheduler-owned, opt-in prefix admission transactions.
+
+The plugin owns its leases and output reservations.  The engine owns request
+state, exact tree-lock receipts and state-slot allocations.  This protocol is
+deliberately limited to nonchunked, device-resident prefill; tree splits, LRU
+refreshes and consumed cache-maintenance actions remain durable cache work.
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass, fields, is_dataclass
+from typing import Any, Callable, Protocol
+
+CAPTURE_ADMISSION_PROTOCOL = 1
+ExecutionIdentity = tuple[str, str, str, int]
+logger = logging.getLogger(__name__)
+
+
+def capture_checkpoint_capability(model_runner) -> dict:
+    """Inspect the *selected* backend and actual recurrent pool, without a probe.
+
+    This is an execution capability gate, not a certificate of numerical
+    equivalence. GPU feature/logit/loss/gradient validation remains required.
+    """
+    backend = model_runner.attn_backend
+    linear = getattr(backend, "linear_attn_backend", None)
+    recurrent = getattr(model_runner.req_to_token_pool, "holds_state_slots", False)
+    if linear is None and not recurrent:
+        return {
+            "supported": True,
+            "kind": "full_attention",
+            "backend": type(backend).__name__,
+        }
+    result = {"supported": False, "kind": "hybrid", "backend": type(linear).__name__}
+    if linear is None or type(linear).__name__ != "GDNAttnBackend":
+        return dict(
+            result, reason="only the selected CUDA Triton GDN path is supported"
+        )
+    pool = linear.state_pool.mamba_cache
+    kernel = linear.kernel_dispatcher.extend_kernel
+    result.update(
+        ssm_dtype=str(pool.temporal.dtype), selected_kernel=type(kernel).__name__
+    )
+    if str(model_runner.device).split(":")[0] != "cuda":
+        return dict(result, reason="exact GDN snapshot requires CUDA")
+    if str(pool.temporal.dtype) != "torch.float32":
+        return dict(result, reason="recurrent state pool must be FP32")
+    graph_runner = getattr(model_runner, "prefill_cuda_graph_runner", None)
+    if graph_runner is not None and type(graph_runner).__name__ != "EagerRunner":
+        return dict(
+            result,
+            reason="GDN prefill graph snapshots are not supported by this protocol",
+        )
+    if (
+        type(kernel).__name__ != "TritonGDNKernel"
+        or not kernel.supports_track_state_snapshot
+    ):
+        return dict(
+            result,
+            reason="selected prefill kernel does not supply FP32 track snapshots",
+        )
+    if getattr(model_runner.req_to_token_pool, "mamba_ckpt_pool", None) is not None:
+        return dict(result, reason="compressed Mamba checkpoints are unsupported")
+    if any(
+        getattr(pool, name, None) is not None
+        for name in ("replayssm_d", "replayssm_rawv")
+    ):
+        return dict(result, reason="ReplaySSM checkpoints are unsupported")
+    return dict(result, supported=True, kind="gdn_fp32_track_snapshot")
+
+
+def validate_capture_checkpoint_support(scheduler) -> dict:
+    from sglang.srt.batch_invariant_ops import is_batch_invariant_mode_enabled
+    from sglang.srt.runtime_context import get_exec
+
+    execution = get_exec()
+    if (
+        not execution.deterministic.enable_deterministic_inference
+        or not is_batch_invariant_mode_enabled()
+    ):
+        raise ValueError("HS reuse requires deterministic batch-invariant execution")
+    mamba = execution.mamba
+    if any(
+        getattr(mamba, name, False)
+        for name in (
+            "enable_int8_mamba_checkpoint",
+            "enable_mamba_cache_stochastic_rounding",
+            "enable_linear_replayssm",
+            "enable_linear_replayssm_spec",
+        )
+    ):
+        raise ValueError(
+            "HS reuse does not support lossy or replay recurrent checkpoints"
+        )
+    capability = capture_checkpoint_capability(scheduler.tp_worker.model_runner)
+    if not capability["supported"]:
+        raise ValueError("HS checkpoint capability refused: " + repr(capability))
+    return capability
+
+
+@dataclass(frozen=True)
+class PrefixAdmissionProposal:
+    max_prefix_len: int
+    identity: ExecutionIdentity
+    opaque: Any = None
+
+    def __post_init__(self):
+        if type(self.max_prefix_len) is not int or self.max_prefix_len < 0:
+            raise ValueError("max_prefix_len must be a nonnegative raw-token count")
+        if (
+            not isinstance(self.identity, tuple)
+            or len(self.identity) != 4
+            or any(not isinstance(x, str) or not x for x in self.identity[:3])
+            or type(self.identity[3]) is not int
+            or self.identity[3] < 0
+        ):
+            raise ValueError("invalid immutable prefix execution identity")
+
+
+class PrefixAdmissionObserver(Protocol):
+    def prepare(self, scheduler, req) -> PrefixAdmissionProposal | None: ...
+    def after_match(self, scheduler, req, proposal, lawful_prefix_len: int) -> None: ...
+    def reserve(self, scheduler, req, proposal, lawful_prefix_len: int) -> bool: ...
+    def commit(self, scheduler, req, proposal, lawful_prefix_len: int) -> None: ...
+    def rollback(self, scheduler, req, proposal, reason: str) -> None: ...
+    def poll(self, scheduler) -> None: ...
+    def lifecycle(self, scheduler, req, event: str, identity) -> None: ...
+    def control(self, scheduler, body: dict) -> dict: ...
+
+
+class AdmissionRollbackError(RuntimeError):
+    """At least one release is uncertain; this execution cannot be retried."""
+
+
+class PrefixAdmissionRejected(RuntimeError):
+    """A request failed admission after every rank completely rolled it back."""
+
+
+@dataclass
+class _Release:
+    description: str
+    release: Callable[[], None]
+    attempted: bool = False
+    error: str | None = None
+    on_commit: Callable[[], None] | None = None
+
+    def run(self):
+        # A release may raise after doing its physical work. Never call it twice.
+        if not self.attempted:
+            self.attempted = True
+            try:
+                self.release()
+            except Exception as exc:
+                self.error = repr(exc)
+                raise
+        elif self.error is not None:
+            raise AdmissionRollbackError(self.error)
+
+
+_REQUEST_FIELDS = (
+    "prefix_len",
+    "last_node",
+    "last_host_node",
+    "best_match_node",
+    "host_hit_length",
+    "swa_host_hit_length",
+    "mamba_host_hit_length",
+    "mamba_branching_seqlen",
+    "swa_branching_seqlen",
+    "num_matched_prefix_tokens",
+    "host_loaded_length",
+    "extend_end",
+    "lock",
+    "logprob_start_len",
+    "_prefix_admission_identity",
+    "_prefix_admission_lifecycle",
+    "extend_batch_idx",
+    "cached_tokens",
+    "cached_tokens_device",
+    "cached_tokens_host",
+    "cached_tokens_storage",
+    "_cache_breakdown_computed",
+    "already_computed",
+    "is_retracted",
+    "retracted_stain",
+    "extra_key",
+    "cache_salt",
+    "matched_window_host_hit_lengths",
+)
+_ADDER_FIELDS = (
+    "rem_input_tokens",
+    "rem_chunk_tokens",
+    "rem_dllm_tokens",
+    "new_chunked_req",
+    "log_hit_tokens",
+    "reprocessed_log_hit_tokens",
+    "log_device_hit_tokens",
+    "log_host_hit_tokens",
+    "log_storage_hit_tokens",
+    "log_input_tokens",
+    "log_replay_tokens",
+    "reprocessed_log_input_tokens",
+    "kv_shard_block_bound_pages",
+    "kv_shard_chunk_pages",
+)
+_MISSING = object()
+
+
+def _snapshot(obj, names):
+    return {name: getattr(obj, name, _MISSING) for name in names}
+
+
+def _restore(obj, values):
+    for name, value in values.items():
+        if value is _MISSING:
+            if hasattr(obj, name):
+                delattr(obj, name)
+        else:
+            setattr(obj, name, value)
+
+
+class NativeAdmissionReceipt:
+    """Own every attempt-local native acquisition until membership commits.
+
+    Allocation sites register physical release operations immediately. Python
+    snapshots restore scheduling metadata only; they do not stand in for frees.
+    A failed release is retained as an uncertain receipt and forbids retry.
+    """
+
+    def __init__(self, adder, req):
+        if getattr(req, "_prefix_native_admission_receipt", None) is not None:
+            raise RuntimeError("nested prefix admission transaction")
+        self.adder, self.req = adder, req
+        self.request_before = _snapshot(req, _REQUEST_FIELDS)
+        # ReqKvInfo is a slotted dataclass on this pin. Keep tensor/allocator
+        # handles by identity and copy only mutable metadata containers.
+        kv_names = (
+            (field.name for field in fields(req.kv))
+            if is_dataclass(req.kv)
+            else vars(req.kv).keys()
+        )
+        self.kv_before = {}
+        for name in kv_names:
+            value = getattr(req.kv, name)
+            self.kv_before[name] = (
+                value.copy() if isinstance(value, (dict, list)) else value
+            )
+        self.fill_ids_before = req.full_untruncated_fill_ids
+        self.fill_len_before = len(self.fill_ids_before)
+        self.adder_before = _snapshot(adder, _ADDER_FIELDS)
+        self.lists_before = {
+            name: list(getattr(adder, name))
+            for name in ("can_run_list", "preempt_list")
+        }
+        self.budget_before = adder.memory_budget.admission_checkpoint()
+        self.releases: list[_Release] = []
+        self.closed = False
+        self.commit_prepared = False
+        self.rollback_errors: list[str] = []
+        req._prefix_native_admission_receipt = self
+
+    def record(self, description, release, on_commit=None):
+        if self.closed:
+            raise RuntimeError("resource acquired after admission receipt closed")
+        item = _Release(description, release, on_commit=on_commit)
+        self.releases.append(item)
+        return item
+
+    def record_tree_lock(self, cache, lock):
+        return self.record("tree lock", lambda: cache.unlock(lock))
+
+    def record_state_slots(self, storage, sub_pool, slots):
+        # Retain the allocator's exact returned vector, including every slot.
+        return self.record(
+            "mamba state slots", lambda: storage.free_state_slots(sub_pool, slots)
+        )
+
+    def prepare_commit(self):
+        if self.closed:
+            raise RuntimeError("admission receipt already closed")
+        # Finalizers only detach admission bookkeeping. Keep physical receipts
+        # live until every rank has completed every potentially failing action.
+        for release in self.releases:
+            if release.on_commit is not None:
+                release.on_commit()
+        self.commit_prepared = True
+
+    def commit(self):
+        if self.closed:
+            raise RuntimeError("admission receipt already closed")
+        if not self.commit_prepared:
+            self.prepare_commit()
+        self.closed = True
+        self.req._prefix_native_admission_receipt = None
+        # Native Req/cache ownership now covers the committed resources.
+        self.releases.clear()
+
+    def rollback(self):
+        if self.closed:
+            if self.rollback_errors:
+                raise AdmissionRollbackError("; ".join(self.rollback_errors))
+            return
+        self.closed = True
+        self.req._prefix_native_admission_receipt = None
+        for item in reversed(self.releases):
+            try:
+                item.run()
+            except Exception as exc:
+                self.rollback_errors.append(f"{item.description}: {exc!r}")
+
+        # Restore metadata even when a physical release failed. The coordinator
+        # gathers that failure and terminates instead of attempting reclamation.
+        def restore_lists():
+            for name, before in self.lists_before.items():
+                getattr(self.adder, name)[:] = before
+
+        def restore_kv():
+            for name, value in self.kv_before.items():
+                setattr(self.req.kv, name, value)
+
+        def restore_ids():
+            del self.fill_ids_before[self.fill_len_before :]
+            self.req.full_untruncated_fill_ids = self.fill_ids_before
+
+        restores = (
+            ("adder metadata", lambda: _restore(self.adder, self.adder_before)),
+            ("adder membership", restore_lists),
+            (
+                "nested budget",
+                lambda: self.adder.memory_budget.restore_admission_checkpoint(
+                    self.budget_before
+                ),
+            ),
+            ("request metadata", lambda: _restore(self.req, self.request_before)),
+            ("request KV metadata", restore_kv),
+            ("request fill ids", restore_ids),
+        )
+        for description, restore in restores:
+            try:
+                restore()
+            except Exception as exc:
+                self.rollback_errors.append(f"{description}: {exc!r}")
+        if self.rollback_errors:
+            raise AdmissionRollbackError("; ".join(self.rollback_errors))
+
+
+def notify_prefix_lifecycle(req, event: str):
+    callback = getattr(req, "_prefix_admission_lifecycle", None)
+    if callback is not None:
+        callback(req, event, getattr(req, "_prefix_admission_identity", None))
+
+
+class PrefixAdmissionCoordinator:
+    """All TP ranks enter each decision and rollback barrier in the same order."""
+
+    def __init__(self, scheduler, *, parallel=None):
+        self.scheduler = scheduler
+        if parallel is None:
+            from sglang.srt.runtime_context import get_parallel
+
+            parallel = get_parallel()
+        self.parallel = parallel
+        self.lifecycle_errors: list[str] = []
+
+    def gather(self, value):
+        s = self.scheduler
+        if self.parallel.tp_size == 1:
+            return [value]
+        import torch.distributed as dist
+
+        values = [None] * self.parallel.tp_size
+        dist.all_gather_object(values, value, group=s.tp_cpu_group)
+        return values
+
+    def broadcast(self, value):
+        s = self.scheduler
+        if self.parallel.tp_size == 1:
+            return value
+        import torch.distributed as dist
+
+        values = [value]
+        dist.broadcast_object_list(
+            values, src=s.tp_group.ranks[0], group=s.tp_cpu_group
+        )
+        return values[0]
+
+    def phase(self, call):
+        value, error = None, None
+        try:
+            value = call()
+        except Exception as exc:
+            logger.warning(
+                "Prefix admission local phase failed: %s", exc, exc_info=True
+            )
+            error = f"{type(exc).__name__}: {exc}"
+        return value, self.gather(error)
+
+    @staticmethod
+    def check(errors, phase):
+        if any(x is not None for x in errors):
+            raise RuntimeError(f"TP prefix {phase} failed: {errors!r}")
+
+    def check_order(self, reqs):
+        orders = self.gather(tuple(req.rid for req in reqs))
+        if any(order != orders[0] for order in orders[1:]):
+            raise RuntimeError("TP prefix waiting request order differs")
+
+    def poll(self):
+        observer = self.scheduler.prefix_admission_observer
+        if observer is not None:
+
+            def poll_local():
+                if self.lifecycle_errors:
+                    raise RuntimeError(repr(self.lifecycle_errors))
+                return observer.poll(self.scheduler)
+
+            _, errors = self.phase(poll_local)
+            self.check(errors, "poll")
+
+    def lifecycle(self, req, event, identity=None):
+        observer = self.scheduler.prefix_admission_observer
+        if observer is not None:
+            try:
+                observer.lifecycle(self.scheduler, req, event, identity)
+            except Exception as exc:
+                # Deferred responses exist on the output rank only. Lifecycle
+                # itself cannot enter a collective; the next all-rank safe
+                # point gathers and raises local failures before new work.
+                self.lifecycle_errors.append(f"{event} {identity!r}: {exc!r}")
+        if event == "shutdown" and self.lifecycle_errors:
+            # Terminal teardown has no later all-rank poll. Preserve its local
+            # failure as a process error, without entering a collective while
+            # peer schedulers may already be exiting.
+            raise RuntimeError(f"prefix shutdown failed: {self.lifecycle_errors!r}")
+
+    def _validate_native_scope(self, req, adder):
+        s = self.scheduler
+        forbidden = (
+            adder.rem_chunk_tokens is not None,
+            req.session is not None,
+            req.kv.holds_kv,
+            req.lock is not None,
+            s.enable_hierarchical_cache,
+            s.enable_hicache_storage,
+            s.enable_lmcache,
+            getattr(s, "enable_unified_cache_external_linker", False),
+            s.enable_priority_preemption,
+            s.dllm_config is not None,
+            getattr(s, "enable_lora", False),
+            getattr(s, "enable_hisparse", False),
+            getattr(s, "uocr_runtime", None) is not None,
+            getattr(s, "is_mixed_chunk", False),
+            self.parallel.pp_size != 1,
+            self.parallel.attn_cp_size != 1,
+            self.parallel.dcp_size != 1,
+            self.parallel.attn_dp_size != 1,
+            getattr(req, "beam_group", None) is not None,
+        )
+        if any(forbidden):
+            raise ValueError(
+                "prefix admission v1 requires nonchunked device-only prefill"
+            )
+
+    def admit(self, req, adder, has_chunked_req, truncation_align_size):
+        """Return None for an ordinary request, otherwise native AddReqResult."""
+        from sglang.srt.managers.schedule_policy import AddReqResult
+        from sglang.srt.mem_cache.capacity import shares_memory
+
+        s, observer = self.scheduler, self.scheduler.prefix_admission_observer
+        for attempt in range(2):
+            receipt = None
+            proposal = None
+            committed = False
+            budget_declined = False
+            reason = "admission failed"
+            try:
+                receipt, errors = self.phase(lambda: NativeAdmissionReceipt(adder, req))
+                self.check(errors, "native receipt")
+
+                def prepare():
+                    value = observer.prepare(s, req)
+                    if value is not None and not isinstance(
+                        value, PrefixAdmissionProposal
+                    ):
+                        raise TypeError(
+                            "prepare must return PrefixAdmissionProposal or None"
+                        )
+                    return value
+
+                proposal, errors = self.phase(prepare)
+                self.check(errors, "prepare")
+                selected = self.gather(proposal is not None)
+                if not any(selected):
+                    # prepare(None) must not acquire plugin resources.
+                    _, errors = self.phase(receipt.rollback)
+                    self.check(errors, "ordinary request restoration")
+                    committed = True
+                    return (
+                        AddReqResult.OTHER
+                        if getattr(adder, "_prefix_pending_admissions", None)
+                        else None
+                    )
+                if not all(selected):
+                    raise RuntimeError("TP prefix protocol request membership differs")
+                if adder.can_run_list and not getattr(
+                    adder, "_prefix_pending_admissions", None
+                ):
+                    reason = "different_prefill_protocol"
+                    return AddReqResult.OTHER
+                _, errors = self.phase(lambda: self._validate_native_scope(req, adder))
+                self.check(errors, "scope")
+                identities = self.gather(proposal.identity)
+                if len(set(identities)) != 1:
+                    raise RuntimeError(
+                        f"TP prefix execution identities differ: {identities!r}"
+                    )
+                cap = self.broadcast(proposal.max_prefix_len)
+                proposal = PrefixAdmissionProposal(
+                    cap, proposal.identity, proposal.opaque
+                )
+                req._prefix_admission_identity = proposal.identity
+                req._prefix_admission_lifecycle = self.lifecycle
+                _, errors = self.phase(
+                    lambda: req.init_next_round_input(
+                        s.tree_cache,
+                        max_prefix_len=cap,
+                        defer_cow_slot=shares_memory(s.token_to_kv_pool_allocator),
+                    )
+                )
+                self.check(errors, "native match")
+                lengths = self.gather(req.prefix_len)
+                if len(set(lengths)) != 1 or not 0 <= lengths[0] <= cap:
+                    raise RuntimeError(f"TP prefix legal lengths differ: {lengths!r}")
+                lawful_l = lengths[0]
+                defer, errors = self.phase(lambda: adder.should_defer(req))
+                self.check(errors, "native deferral check")
+                if any(self.gather(defer)):
+                    reason = "native_admission_deferred"
+                    return AddReqResult.OTHER
+                if any(self.gather(req.needs_host_load_back())):
+                    raise ValueError(
+                        "prefix admission v1 does not support host load-back"
+                    )
+                _, errors = self.phase(
+                    lambda: observer.after_match(s, req, proposal, lawful_l)
+                )
+                self.check(errors, "after_match")
+                accepted, errors = self.phase(
+                    lambda: observer.reserve(s, req, proposal, lawful_l)
+                )
+                self.check(errors, "reserve")
+                if not all(self.gather(accepted is True)):
+                    budget_declined = True
+                    reason = "capture_budget_declined"
+                else:
+                    result, errors = self.phase(
+                        lambda: adder.add_one_req(
+                            req, has_chunked_req, truncation_align_size
+                        )
+                    )
+                    self.check(errors, "native admission")
+                    votes = self.gather(
+                        (
+                            any(item is req for item in adder.can_run_list),
+                            req.prefix_len,
+                            len(req.full_untruncated_fill_ids),
+                            proposal.identity,
+                            result.name,
