+
+class Budget:
+    def __init__(self):
+        self.total_offset = 3
+        self.current_offset = 2
+        self.swa_offset = 1
+        self.rem_state_slots = 9
+
+    def admission_checkpoint(self):
+        return vars(self).copy()
+
+    def restore_admission_checkpoint(self, mark):
+        vars(self).update(mark)
+
+
+class Request:
+    def __init__(self, rid="r", match_len=2):
+        self.rid = rid
+        self.kv = types.SimpleNamespace(
+            holds_kv=False,
+            mamba_pool_idx=None,
+            req_pool_idx=None,
+            cache_protected_len=0,
+            component_evicted_seqlens={},
+        )
+        self.session = self.lock = self.extend_end = None
+        self.prefix_len = 0
+        self.origin_input_ids = list(range(8))
+        self.full_untruncated_fill_ids = []
+        self.resources = set()
+        self.match_len = match_len
+
+    def acquire(self, name):
+        if name in self.resources:
+            raise AssertionError("resource allocated twice")
+        self.resources.add(name)
+        self._prefix_native_admission_receipt.record(
+            name, lambda: self.resources.remove(name)
+        )
+
+    def init_next_round_input(self, cache, *, max_prefix_len, defer_cow_slot=False):
+        self.full_untruncated_fill_ids[:] = self.origin_input_ids
+        self.prefix_len = min(max_prefix_len, self.match_len)
+        if self.kv.mamba_pool_idx is None:
+            self.acquire("cow")
+            self.kv.mamba_pool_idx = "cow"
+
+    def needs_host_load_back(self):
+        return False
+
+
+class Adder:
+    def __init__(self, mode="append"):
+        self.can_run_list = []
+        self.preempt_list = []
+        self.rem_chunk_tokens = None
+        self.rem_input_tokens = 100
+        self.new_chunked_req = None
+        self.memory_budget = Budget()
+        self.mode = mode
+
+    def should_defer(self, req):
+        return False
+
+    def add_one_req(self, req, *args):
+        req.extend_end = len(req.origin_input_ids)
+        self.rem_input_tokens -= 6
+        self.memory_budget.total_offset += 13
+        self.memory_budget.swa_offset += 5
+        self.memory_budget.rem_state_slots -= 3
+        req.acquire("lock")
+        if self.mode != "no_membership":
+            self.can_run_list.append(req)
+        if self.mode == "append_then_raise":
+            raise RuntimeError("after append")
+        return Result.CONTINUE
