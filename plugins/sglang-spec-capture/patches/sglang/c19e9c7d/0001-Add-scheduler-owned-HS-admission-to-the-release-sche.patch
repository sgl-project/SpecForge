+"""Actual pinned Req/ReqKvInfo/budget CPU interface regression.
+
+Source method bodies and dataclass decorators are executed unchanged. Clock,
+mode enum and IPC leaves are small doubles; no model, CUDA or venv is loaded.
+This establishes the CPU boundary, not real scheduler/GPU acceptance.
+"""
+
+import ast
+import copy
+import dataclasses
+import importlib.util
+import logging
+import sys
+import types
+import unittest
+from array import array
+from http import HTTPStatus
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[4]
+SOURCE = ROOT / "python/sglang/srt"
+spec = importlib.util.spec_from_file_location(
+    "actual_req_prefix_admission", SOURCE / "managers/prefix_admission.py"
+)
+P = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = P
+spec.loader.exec_module(P)
+
+
+def extract(relative, names, namespace, methods=None):
+    source = ast.parse((SOURCE / relative).read_text())
+    selected = [
+        node
+        for node in source.body
+        if isinstance(node, (ast.ClassDef, ast.FunctionDef)) and node.name in names
+    ]
+    if methods:
+        for cls in selected:
+            if isinstance(cls, ast.ClassDef) and cls.name in methods:
+                cls.body = [
+                    node
+                    for node in cls.body
+                    if isinstance(node, ast.FunctionDef)
+                    and node.name in methods[cls.name]
+                ]
+    body = [
+        ast.ImportFrom(
+            module="__future__", names=[ast.alias(name="annotations")], level=0
+        ),
+        *selected,
+    ]
+    exec(
+        compile(
+            ast.fix_missing_locations(ast.Module(body=body, type_ignores=[])),
+            str(SOURCE / relative),
+            "exec",
+        ),
+        namespace,
+    )
+
+
+class ClockLeaf:
+    def __init__(self, **kwargs):
+        pass
+
+    def set_metrics_collector(self, value):
+        pass
+
+    def set_scheduler_recv_time(self):
+        pass
+
+
+def actual_namespace():
+    module = types.ModuleType("pinned_actual_req_methods")
+    sys.modules[module.__name__] = module
+    namespace = vars(module)
+    namespace.update(
+        dataclasses=dataclasses,
+        dataclass=dataclasses.dataclass,
+        array=array,
+        copy=copy,
+        HTTPStatus=HTTPStatus,
+        SchedulerReqTimeStats=ClockLeaf,
+        CaptureHiddenMode=types.SimpleNamespace(NULL=0, FULL=1, LAST=2),
+        FAKE_BOOTSTRAP_HOST="fake",
+        is_cp_sharded_padded=lambda: False,
+    )
+    extract("mem_cache/base_prefix_cache.py", {"CacheRequestHandle"}, namespace)
+    extract(
+        "dllm/mixin/req.py",
+        {"ReqDllmMixin"},
+        namespace,
+        {"ReqDllmMixin": {"init_diffusion_llm", "is_dllm", "reset_dllm_progress"}},
+    )
+    extract(
+        "managers/req_types.py",
+        {"get_return_hidden_states_mode", "BaseFinishReason", "FINISH_ABORT"},
+        namespace,
+    )
+    extract(
+        "managers/schedule_batch.py",
+        {
+            "ReqKvInfo",
+            "ReqLogprob",
+            "Req",
+            "BaseFinishReason",
+            "FINISH_ABORT",
+        },
+        namespace,
+        {
+            "Req": {
+                "__init__",
+                "refresh_fill_ids",
+                "init_next_round_input",
+                "_compute_max_prefix_len",
+                "needs_host_load_back",
+                "auxiliary_swa_host_hit_length",
+                "finish_outside_step",
+            }
+        },
+    )
+    extract(
+        "mem_cache/prefill_budget.py",
+        {"PrefillAdmissionCheckpoint", "PrefillBudget"},
+        namespace,
+    )
+    return namespace
+
