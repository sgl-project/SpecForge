+    def rollback_pending(self, adder, reason):
+        errors = []
+        for receipt, proposal, _ in reversed(
+            getattr(adder, "_prefix_pending_admissions", [])
+        ):
+            try:
+                receipt.rollback()
+            except Exception as exc:
+                errors.append(f"native {proposal.identity!r}: {exc!r}")
+            try:
+                self.scheduler.prefix_admission_observer.rollback(
+                    self.scheduler, receipt.req, proposal, reason
+                )
+            except Exception as exc:
+                errors.append(f"plugin {proposal.identity!r}: {exc!r}")
+        all_errors = self.gather(errors)
+        if any(all_errors):
+            raise AdmissionRollbackError(f"TP batch rollback failed: {all_errors!r}")
+        adder._prefix_pending_admissions = []
