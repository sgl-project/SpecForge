+                c, observer, _, _ = self.make()
+
+                def fail(*args):
+                    raise RuntimeError("native drain unproven")
+
+                observer.lifecycle = fail
+                if previous:
+                    c.lifecycle(None, "cancel", ("epoch", "rid", "attempt", 1))
+                    observer.lifecycle = lambda *args: None
+                with self.assertRaisesRegex(
+                    RuntimeError, "prefix shutdown failed.*native drain unproven"
+                ):
+                    c.lifecycle(None, "shutdown")
+                self.assertEqual(len(c.lifecycle_errors), 1)
+                self.assertEqual(c.round, 0)  # Terminal cleanup must stay rank-local.
