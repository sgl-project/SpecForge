+
+def batch_admission_receipt(reqs):
+    receipts = [getattr(req, "_prefix_native_admission_receipt", None) for req in reqs]
+    if not any(receipts):
+        return None
+    if not all(receipts):
+        raise RuntimeError(
+            "transactional and ordinary prefills cannot share allocations"
+        )
+    return receipts[0]
+
+
+def record_batch_token_allocation(batch, storage, token_ids):
+    """Receipt for newly allocated pages, excluding a borrowed prefix tail."""
+    receipt = batch_admission_receipt(batch.reqs)
+    if receipt is None:
+        return None
+    page_size = batch.token_to_kv_pool_allocator.page_size
+    segments, offset = [], 0
+    for prefix_len, extend_len in zip(batch.prefix_lens, batch.extend_lens):
+        borrowed = min(extend_len, (-prefix_len) % page_size)
+        if borrowed < extend_len:
+            segments.append(token_ids[offset + borrowed : offset + extend_len])
+        offset += extend_len
+
+    def release():
+        for segment in segments:
+            storage.free_tokens(segment)
+
+    return receipt.record("batch token KV pages", release)
+
+
+def record_request_rows(table, rows, receipt):
+    """Record raw rows before generation updates, callbacks or Req binding."""
+    if receipt is None:
+        return
+    if not hasattr(table, "_prefix_admission_row_releases"):
+        table._prefix_admission_row_releases = {}
+    registry = table._prefix_admission_row_releases
+    for row in rows:
+        if row in registry:
+            raise RuntimeError("request row already has an admission owner")
+
+        def release(row=row):
+            registry.pop(row, None)
+            table._free_rows_without_admission([row])
+
+        registry[row] = receipt.record(
+            "request row", release, on_commit=lambda row=row: registry.pop(row, None)
+        )
+
+
+def free_request_rows(table, rows):
+    """Native exhaustion cleanup consumes the same exact row receipts."""
+    registry = getattr(table, "_prefix_admission_row_releases", {})
+    for row in rows:
+        release = registry.get(row)
+        if release is None:
+            table._free_rows_without_admission([row])
+        else:
+            release.run()
