+    def prepare_batch(self, adder, batch):
+        """Acquire actual batch resources, agree TP success, then freeze plans."""
+        pending = getattr(adder, "_prefix_pending_admissions", [])
+        if not pending:
+            batch.prepare_for_extend()
+            return
+        observer, s = self.scheduler.prefix_admission_observer, self.scheduler
+        reason = "batch construction failed"
+        committed = False
+        try:
+            _, errors = self.phase(batch.prepare_for_extend)
+            self.check(errors, "batch allocation")
+            for receipt, proposal, lawful_l in pending:
+                _, errors = self.phase(
+                    lambda: observer.commit(s, receipt.req, proposal, lawful_l)
+                )
+                self.check(errors, "commit")
+            _, errors = self.phase(
+                lambda: [receipt.prepare_commit() for receipt, _, _ in pending]
+            )
+            self.check(errors, "native commit preparation")
+            for receipt, _, _ in pending:
+                receipt.commit()
+            committed = True
+        except Exception as exc:
+            reason = str(exc)
+            raise
