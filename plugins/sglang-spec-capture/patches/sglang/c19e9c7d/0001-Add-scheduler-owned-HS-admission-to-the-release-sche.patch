+            except Exception as exc:
+                reason = str(exc)
+                raise PrefixAdmissionRejected(reason) from exc
+            finally:
+                if not committed:
+                    cleanup_errors = []
+                    try:
+                        if receipt is not None:
+                            receipt.rollback()
+                    except Exception as exc:
+                        cleanup_errors.append(f"native: {exc!r}")
+                    try:
+                        observer.rollback(s, req, proposal, reason)
+                    except Exception as exc:
+                        cleanup_errors.append(f"plugin: {exc!r}")
