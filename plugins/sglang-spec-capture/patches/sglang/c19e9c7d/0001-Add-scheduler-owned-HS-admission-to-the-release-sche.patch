+
+    def test_actual_scheduler_rejection_preserves_phase_status_and_trace(self):
+        namespace = self.ns
+        namespace.update(
+            logger=logging.getLogger("actual_prefix_rejection"),
+            AbortReq=types.SimpleNamespace,
+            PrefixAdmissionRejected=P.PrefixAdmissionRejected,
+            compute_weight_version_spans=lambda *args, **kwargs: [],
+            get_serving=lambda: types.SimpleNamespace(weight_version="default"),
+        )
+        for name in (
+            "SchedulerDisaggregationDecodeMixin",
+            "SchedulerDisaggregationPrefillMixin",
+            "SchedulerPPMixin",
+            "SchedulerDllmMixin",
+            "SchedulerMlxOverlapMixin",
+        ):
+            namespace[name] = type(name, (), {})
+        namespace["resolve_forward_inputs"] = None
+        extract(
+            "managers/scheduler.py",
+            {"Scheduler"},
+            namespace,
+            {"Scheduler": {"_reject_prefix_admission"}},
+        )
+        scheduler = namespace["Scheduler"]()
+        scheduler.waiting_queue = [self.req]
+        released, sent = [], []
+
+        def abort(req, *, reason, finished_reason):
+            self.assertIs(req, self.req)
+            scheduler.waiting_queue.remove(req)
+            released.append(req)
+            req.finished_reason = reason
+            sent.append(types.SimpleNamespace(finished_reason=finished_reason))
+
+        scheduler.request_retirer = types.SimpleNamespace(abort=abort)
+        with self.assertLogs("actual_prefix_rejection", level="WARNING") as logs:
+            try:
+                raise TypeError("vars() argument must have __dict__ attribute")
+            except TypeError as native:
+                try:
+                    raise P.PrefixAdmissionRejected(
+                        "TP prefix native receipt failed: TypeError: " + str(native)
+                    ) from native
+                except P.PrefixAdmissionRejected as exc:
+                    scheduler._reject_prefix_admission(self.req, exc)
+        self.assertEqual(released, [self.req])
+        self.assertEqual(scheduler.waiting_queue, [])
+        self.assertEqual(sent[0].finished_reason, self.req.finished_reason.to_json())
+        self.assertEqual(sent[0].finished_reason["status_code"], 400)
+        self.assertIn("native receipt failed", sent[0].finished_reason["message"])
+        self.assertIn("__dict__", "\n".join(logs.output))
+        self.assertIsNotNone(logs.records[0].exc_info)
