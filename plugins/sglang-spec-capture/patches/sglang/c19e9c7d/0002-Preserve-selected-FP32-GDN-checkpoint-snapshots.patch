diff --git a/test/registered/unit/managers/test_gdn_track_snapshot_contract.py b/test/registered/unit/managers/test_gdn_track_snapshot_contract.py
new file mode 100644
index 0000000000..ac0e76006d
--- /dev/null
+++ b/test/registered/unit/managers/test_gdn_track_snapshot_contract.py
@@ -0,0 +1,193 @@
+"""Execute actual GDN wrapper bodies with CPU leaf doubles.
+
+These cases establish argument plumbing and capability refusal only. Real
+FP32 accumulator/checkpoint and resumed feature equivalence require CUDA tests.
+"""
+
+import ast
+import types
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[4]
+
+
+class Tensor:
+    def __init__(self, dtype="bf16", shape=(1, 8, 2, 4)):
+        self.dtype, self.shape = dtype, shape
+
+    def is_contiguous(self):
+        return True
+
+    def to(self, dtype):
+        if dtype != self.dtype:
+            raise AssertionError("ordinary output dtype changed")
+        return self
+
+
+def wrappers():
+    class Function:
+        @classmethod
+        def apply(cls, *args):
+            return cls.forward(None, *args)
+
+    torch = types.SimpleNamespace(
+        autograd=types.SimpleNamespace(Function=Function),
+        compiler=types.SimpleNamespace(disable=lambda fn: fn),
+        float32="fp32",
+    )
+    observed = {}
+
+    def state_kernel(**kwargs):
+        observed.update(kwargs)
+        return Tensor(), Tensor()
+
+    namespace = {
+        "torch": torch,
+        "input_guard": lambda **kwargs: (lambda fn: fn),
+        "autocast_custom_fwd": lambda fn: fn,
+        "chunk_local_cumsum": lambda value, **kwargs: value,
+        "chunk_gated_delta_rule_fwd_intra": lambda **kwargs: (Tensor(), Tensor(), None),
+        "chunk_gated_delta_rule_fwd_h": state_kernel,
+        "chunk_fwd_o": lambda **kwargs: Tensor(),
+        "l2norm_fwd": lambda value: value,
+        "SUPPRESS_LEVEL": 0,
+        "is_intel": False,
+        "CHUNK_SIZE": 64,
+    }
+    source = ast.parse(
+        (ROOT / "python/sglang/kernels/ops/attention/fla/chunk.py").read_text()
+    )
+    body = [
+        ast.ImportFrom(
+            module="__future__", names=[ast.alias(name="annotations")], level=0
+        )
+    ]
+    body += [
+        node
+        for node in source.body
+        if isinstance(node, (ast.FunctionDef, ast.ClassDef))
+    ]
+    exec(
+        compile(
+            ast.fix_missing_locations(ast.Module(body=body, type_ignores=[])),
+            "actual_fla_wrappers",
+            "exec",
+        ),
+        namespace,
+    )
+    return namespace, observed
+
+
+def gdn_kernel_class(chunk):
+    source = ast.parse(
+        (
+            ROOT / "python/sglang/srt/layers/attention/linear/kernels/gdn_triton.py"
+        ).read_text()
+    )
+    original = next(
+        node
+        for node in source.body
+        if isinstance(node, ast.ClassDef) and node.name == "TritonGDNKernel"
+    )
+    extend = next(
+        node
+        for node in original.body
+        if isinstance(node, ast.FunctionDef) and node.name == "extend"
+    )
+    body = [
+        ast.ImportFrom(
+            module="__future__", names=[ast.alias(name="annotations")], level=0
+        )
+    ]
+    body.append(
+        ast.ClassDef(
+            name="ActualKernel", bases=[], keywords=[], body=[extend], decorator_list=[]
+        )
+    )
+    namespace = {
+        "is_cpu": lambda: False,
+        "is_npu": lambda: False,
+        "chunk_gated_delta_rule": chunk,
+    }
+    exec(
+        compile(
+            ast.fix_missing_locations(ast.Module(body=body, type_ignores=[])),
+            "actual_gdn_extend",
+            "exec",
+        ),
+        namespace,
+    )
+    cls = namespace["ActualKernel"]
+    cls.supports_track_state_snapshot = True
+    return cls
+
+
+class SnapshotWrapperTests(unittest.TestCase):
+    def invoke(self, fn, **kwargs):
+        return fn(
+            q=Tensor(),
+            k=Tensor(),
+            v=Tensor(),
+            g=Tensor(),
+            beta=Tensor(shape=(1, 8, 2)),
+            initial_state=Tensor("fp32"),
+            **kwargs
+        )
+
+    def test_actual_fla_wrappers_forward_selected_fp32_buffer_without_cast(self):
+        namespace, observed = wrappers()
+        snapshot, indices = Tensor("fp32"), object()
+        self.invoke(
+            namespace["chunk_gated_delta_rule"],
+            track_state=snapshot,
+            track_chunk_idx=indices,
+        )
+        self.assertIs(observed["track_state"], snapshot)
+        self.assertIs(observed["track_chunk_idx"], indices)
+        self.assertEqual(observed["k"].dtype, "bf16")
+
+    def test_untracked_fla_call_keeps_external_backend_signature(self):
+        namespace, observed = wrappers()
+        self.invoke(namespace["chunk_gated_delta_rule"])
+        self.assertNotIn("track_state", observed)
+        self.assertNotIn("track_chunk_idx", observed)
+
+    def test_actual_gdn_extend_forwards_to_entire_fla_chain(self):
+        namespace, observed = wrappers()
+        kernel = gdn_kernel_class(namespace["chunk_gated_delta_rule"])()
+        snapshot, indices = Tensor("fp32"), object()
+        kernel.extend(
+            Tensor(),
+            Tensor(),
+            Tensor(),
+            Tensor(),
+            Tensor(shape=(1, 8, 2)),
+            ssm_states=Tensor("fp32"),
+            cache_indices=None,
+            query_start_loc=None,
+            track_state=snapshot,
+            track_chunk_idx=indices,
+        )
+        self.assertIs(observed["track_state"], snapshot)
+        self.assertIs(observed["track_chunk_idx"], indices)
+
+    def test_actual_gdn_extend_rejects_unsupported_or_incomplete_snapshot(self):
+        namespace, _ = wrappers()
+        kernel = gdn_kernel_class(namespace["chunk_gated_delta_rule"])()
+        args = (Tensor(), Tensor(), Tensor(), Tensor(), Tensor())
+        common = dict(
+            ssm_states=Tensor("fp32"), cache_indices=None, query_start_loc=None
+        )
+        with self.assertRaises(ValueError):
+            kernel.extend(*args, **common, track_state=Tensor("fp32"))
+        kernel.supports_track_state_snapshot = False
+        with self.assertRaises(NotImplementedError):
+            kernel.extend(
+                *args, **common, track_state=Tensor("fp32"), track_chunk_idx=object()
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
