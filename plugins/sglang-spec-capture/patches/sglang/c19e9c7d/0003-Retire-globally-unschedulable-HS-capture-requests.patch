 class Budget:
@@ -458,6 +459,28 @@ class PrefixAdmissionTests(unittest.TestCase):
             results = [future.result(timeout=8) for future in futures]
         return replicas, results

+    def test_tp_terminal_decline_rolls_back_every_rank_without_retry(self):
+        def run(rank, coordinator, observer, req, adder):
+            original = adder.add_one_req
+            if rank == 1:
+
+                def fail_to_admit(*args):
+                    original(*args)
+                    adder.can_run_list.clear()
+                    return Result.UNSCHEDULABLE
+
+                adder.add_one_req = fail_to_admit
+            return coordinator.admit(req, adder, False, None)
+
+        replicas, verdicts = self.run_two(run)
+        self.assertEqual(verdicts, [Result.UNSCHEDULABLE] * 2)
+        for _, observer, req, adder in replicas:
+            self.assertEqual(observer.prepares, 1)
+            self.assertEqual(observer.rollbacks, 1)
+            self.assertFalse(
+                observer.reservations or adder.can_run_list or req.resources
+            )
+
     def test_tp_match_disagreement_rolls_back_every_rank(self):
         def run(rank, c, observer, req, adder):
             req.match_len += rank
