diff --git a/python/sglang/srt/managers/scheduler.py b/python/sglang/srt/managers/scheduler.py
index 7d4ced2509..a979ae6c7f 100644
--- a/python/sglang/srt/managers/scheduler.py
+++ b/python/sglang/srt/managers/scheduler.py
@@ -534,6 +534,7 @@ class Scheduler(
     rust_server: Optional[RustServer] = None
     # The alignment a truncated prefill chunk is cut to; None leaves it free.
     truncation_align_size: Optional[int] = None
+    prefix_admission_observer = None

     # Class-level default so on_idle's stall gate works even if a fork
     # overrides init_load_publisher (which would otherwise not set it).
@@ -556,7 +557,6 @@ class Scheduler(
         # with minimal glue. Move substantial component-specific logic into
         # dedicated methods instead of adding inline blocks here.
         self.init_startup_timing_begin()
-        self.prefix_admission_observer = None
         self.prefix_admission_coordinator = PrefixAdmissionCoordinator(self, parallel=get_parallel())
         self.is_initializing = True
         # init_soft_watchdog starts a daemon thread that reads these on its first tick.
@@ -3989,6 +3989,10 @@ class Scheduler(
         self.request_retirer.abort(req, reason=reason, finished_reason=reason.to_json())

     def _abort_unavailable(self, req: Req, *, message: str) -> None:
+        if self.prefix_admission_observer is not None:
+            self.prefix_admission_coordinator.lifecycle(
+                req, "cancel", getattr(req, "_prefix_admission_identity", None)
+            )
         self.request_retirer.abort(
             req,
             reason=FINISH_ABORT(message, HTTPStatus.SERVICE_UNAVAILABLE),
diff --git a/test/registered/unit/managers/test_prefix_admission.py b/test/registered/unit/managers/test_prefix_admission.py
