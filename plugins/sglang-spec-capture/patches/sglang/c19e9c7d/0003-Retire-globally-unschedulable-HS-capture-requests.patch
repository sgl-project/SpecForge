diff --git a/python/sglang/srt/managers/prefix_admission.py b/python/sglang/srt/managers/prefix_admission.py
index dc7ab36801..0bfd1f63a0 100644
--- a/python/sglang/srt/managers/prefix_admission.py
+++ b/python/sglang/srt/managers/prefix_admission.py
@@ -586,6 +586,9 @@ class PrefixAdmissionCoordinator:
                             if len({v[4] for v in votes}) == 1
                             else AddReqResult.OTHER
                         )
+                    if any(v[4] == "UNSCHEDULABLE" for v in votes):
+                        reason = "native_admission_unschedulable"
+                        return AddReqResult.UNSCHEDULABLE
                     reason = "native_admission_declined"
