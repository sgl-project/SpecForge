+def free_request_rows(table, rows):
+    """Native exhaustion cleanup consumes the same exact row receipts."""
+    registry = getattr(table, "_prefix_admission_row_releases", {})
+    for row in rows:
+        release = registry.get(row)
+        if release is None:
+            table._free_rows_without_admission([row])
+        else:
+            release.run()
