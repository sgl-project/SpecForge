@@ -0,0 +1,410 @@
+"""CPU ownership/collective contracts; these do not certify GPU numerics."""
+
+import concurrent.futures
+import importlib.util
+import sys
+import threading
+import types
+import unittest
+from enum import Enum
+from pathlib import Path
+from unittest.mock import patch
+
+
+SOURCE = Path(__file__).resolve().parents[4] / "python/sglang/srt/managers/prefix_admission.py"
+SPEC = importlib.util.spec_from_file_location("prefix_admission_contract", SOURCE)
+P = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = P
+SPEC.loader.exec_module(P)
+
+
+class Result(Enum):
+    CONTINUE = 1
+    OTHER = 2
+    NO_TOKEN = 3
+
+
+class Budget:
+    def __init__(self):
+        self.total_offset = 3
+        self.current_offset = 2
+        self.swa_offset = 1
+        self.rem_state_slots = 9
+
+    def admission_checkpoint(self):
+        return vars(self).copy()
+
+    def restore_admission_checkpoint(self, mark):
+        vars(self).update(mark)
+
+
+class Request:
+    def __init__(self, rid="r", match_len=2):
+        self.rid = rid
+        self.kv = types.SimpleNamespace(
+            holds_kv=False, mamba_pool_idx=None, req_pool_idx=None,
+            cache_protected_len=0, component_evicted_seqlens={},
+        )
+        self.session = self.lock = self.extend_end = None
+        self.prefix_len = 0
+        self.origin_input_ids = list(range(8))
+        self.full_untruncated_fill_ids = []
+        self.resources = set()
+        self.match_len = match_len
+
+    def acquire(self, name):
+        if name in self.resources:
+            raise AssertionError("resource allocated twice")
+        self.resources.add(name)
+        self._prefix_native_admission_receipt.record(name, lambda: self.resources.remove(name))
+
+    def init_next_round_input(self, cache, *, max_prefix_len):
+        self.full_untruncated_fill_ids[:] = self.origin_input_ids
+        self.prefix_len = min(max_prefix_len, self.match_len)
+        if self.kv.mamba_pool_idx is None:
+            self.acquire("cow")
+            self.kv.mamba_pool_idx = "cow"
+
+    def needs_host_load_back(self):
+        return False
+
+
+class Adder:
+    def __init__(self, mode="append"):
+        self.can_run_list = []
+        self.preempt_list = []
+        self.rem_chunk_tokens = None
+        self.rem_input_tokens = 100
+        self.new_chunked_req = None
+        self.memory_budget = Budget()
+        self.mode = mode
+
+    def add_one_req(self, req, *args):
+        req.extend_end = len(req.origin_input_ids)
+        self.rem_input_tokens -= 6
+        self.memory_budget.total_offset += 13
+        self.memory_budget.swa_offset += 5
+        self.memory_budget.rem_state_slots -= 3
+        req.acquire("lock")
+        if self.mode != "no_membership":
+            self.can_run_list.append(req)
+        if self.mode == "append_then_raise":
+            raise RuntimeError("after append")
+        return Result.CONTINUE
+
+
+class Observer:
+    def __init__(self, *, rank=0, accepted=True):
+        self.rank = rank
+        self.accepted = accepted
+        self.prepares = self.polls = self.rollbacks = self.commits = 0
+        self.fail_poll = self.fail_commit = False
+        self.reservations = set()
+
+    def prepare(self, s, req):
+        self.prepares += 1
+        return P.PrefixAdmissionProposal(6 if self.rank == 0 else 0, ("server", req.rid, "attempt", 0))
+
+    def after_match(self, *args):
+        pass
+
+    def reserve(self, s, req, proposal, lawful_l):
+        if self.accepted:
+            self.reservations.add(proposal.identity)
+        return self.accepted
+
+    def commit(self, s, req, proposal, lawful_l):
+        self.commits += 1
+        # Freeze is permitted only after actual row/token/tracking acquisition.
+        if not {"row", "tokens", "tracking"} <= req.resources:
+            raise AssertionError("plan froze before physical batch allocation")
+        if self.fail_commit:
+            raise RuntimeError("publication plan freeze failed")
+
+    def rollback(self, s, req, proposal, reason):
+        self.rollbacks += 1
+        if proposal is not None:
+            self.reservations.discard(proposal.identity)
+
+    def poll(self, s):
+        self.polls += 1
+        if self.fail_poll:
+            raise RuntimeError("rank-local reclaim failure")
+
+    def lifecycle(self, *args):
+        pass
+
+
+class Batch:
+    def __init__(self, reqs, *, fail=False, fail_finalizer=False):
+        self.reqs = reqs
+        self.fail = fail
+        self.fail_finalizer = fail_finalizer
+
+    def prepare_for_extend(self):
+        for req in self.reqs:
+            for name in ("row", "tracking", "tokens"):
+                req.acquire(name)
+            req.kv.req_pool_idx = 7
+            if self.fail:
+                raise RuntimeError("partial physical allocation")
+            if self.fail_finalizer:
+                def fail():
+                    raise RuntimeError("commit finalizer failed")
+                req._prefix_native_admission_receipt.record("finalizer", lambda: None, on_commit=fail)
+
+
+def scheduler(observer, tp=1):
+    s = types.SimpleNamespace(
+        prefix_admission_observer=observer, tree_cache=object(),
+        enable_hierarchical_cache=False, enable_hicache_storage=False,
+        enable_lmcache=False, enable_priority_preemption=False, dllm_config=None,
+    )
+    parallel = types.SimpleNamespace(tp_size=tp, pp_size=1, attn_cp_size=1, dcp_size=1, attn_dp_size=1)
+    return s, parallel
+
+
+class CollectiveGroup:
+    """Deterministic two-rank rendezvous; a missing phase fails the test."""
+    def __init__(self):
+        self.barrier = threading.Barrier(2, timeout=3)
+        self.values = {}
+        self.lock = threading.Lock()
+
+    def gather(self, rank, phase, value):
+        with self.lock:
+            self.values.setdefault(phase, {})[rank] = value
+        self.barrier.wait()
+        result = [self.values[phase][i] for i in range(2)]
+        self.barrier.wait()
+        return result
+
+
+class Coordinator(P.PrefixAdmissionCoordinator):
+    def __init__(self, s, parallel, group=None, rank=0):
+        super().__init__(s, parallel=parallel)
+        self.group, self.rank, self.round = group, rank, 0
+
+    def gather(self, value):
+        if self.group is None:
+            return [value]
+        phase = self.round
+        self.round += 1
+        return self.group.gather(self.rank, phase, value)
+
+    def broadcast(self, value):
+        return self.gather(value)[0]
+
+
+class PrefixAdmissionTests(unittest.TestCase):
+    def setUp(self):
+        self.patch = patch.dict(sys.modules, {
+            "sglang.srt.managers.schedule_policy": types.SimpleNamespace(AddReqResult=Result)
+        })
+        self.patch.start()
+
+    def tearDown(self):
+        self.patch.stop()
+
+    def make(self, observer=None, mode="append"):
+        observer = observer or Observer()
+        s, parallel = scheduler(observer)
+        return Coordinator(s, parallel), observer, Request(), Adder(mode)
+
+    def test_reverse_physical_release_and_nested_budget_restore(self):
+        _, _, req, adder = self.make()
+        before = adder.memory_budget.admission_checkpoint()
+        receipt = P.NativeAdmissionReceipt(adder, req)
+        order = []
+        receipt.record("first", lambda: order.append(1))
+        receipt.record("second", lambda: order.append(2))
+        adder.memory_budget.swa_offset = 100
+        adder.memory_budget.rem_state_slots = -4
+        adder.can_run_list.append(req)
+        req.kv.component_evicted_seqlens["full"] = 11
+        receipt.rollback()
+        self.assertEqual(order, [2, 1])
+        self.assertEqual(vars(adder.memory_budget), before)
+        self.assertEqual(adder.can_run_list, [])
+        self.assertEqual(req.kv.component_evicted_seqlens, {})
+
+    def test_release_exception_is_not_retried_and_other_resources_are_released(self):
+        _, _, req, adder = self.make()
+        receipt = P.NativeAdmissionReceipt(adder, req)
+        calls = []
+        receipt.record("safe", lambda: calls.append("safe"))
+        def uncertain():
+            calls.append("uncertain")
+            raise RuntimeError("failed after physical release")
+        receipt.record("uncertain", uncertain)
+        for _ in range(2):
+            with self.assertRaises(P.AdmissionRollbackError):
+                receipt.rollback()
+        self.assertEqual(calls, ["uncertain", "safe"])
+
+    def test_raw_rows_are_receipted_before_req_binding(self):
+        _, _, req, adder = self.make()
+        receipt = P.NativeAdmissionReceipt(adder, req)
+        table = types.SimpleNamespace(free_slots=[])
+        table._free_rows_without_admission = lambda rows: table.free_slots.extend(rows)
+        P.record_request_rows(table, [4, 5], receipt)
+        # Native exhaustion can free a row before the transaction rolls back.
+        P.free_request_rows(table, [4])
+        receipt.rollback()
+        self.assertEqual(sorted(table.free_slots), [4, 5])
+
+    def test_commit_finalizer_failure_retains_physical_receipts(self):
+        _, _, req, adder = self.make()
+        receipt = P.NativeAdmissionReceipt(adder, req)
+        req.acquire("tokens")
+        def fail():
+            raise RuntimeError("detach failed")
+        receipt.record("detach", lambda: None, on_commit=fail)
+        with self.assertRaisesRegex(RuntimeError, "detach failed"):
+            receipt.commit()
+        self.assertFalse(receipt.closed)
+        receipt.rollback()
+        self.assertEqual(req.resources, set())
+
+    def test_freeze_waits_for_physical_batch_allocation(self):
+        c, observer, req, adder = self.make()
+        self.assertEqual(c.admit(req, adder, False, None), Result.CONTINUE)
+        self.assertEqual(observer.commits, 0)
+        self.assertIsNotNone(req._prefix_native_admission_receipt)
+        c.build_batch(adder, lambda: Batch([req]))
+        self.assertEqual(observer.commits, 1)
+        self.assertIsNone(req._prefix_native_admission_receipt)
+        self.assertEqual(req.resources, {"cow", "lock", "row", "tracking", "tokens"})
+
+    def test_continue_without_membership_never_freezes(self):
+        c, observer, req, adder = self.make(mode="no_membership")
+        self.assertEqual(c.admit(req, adder, False, None), Result.OTHER)
+        self.assertEqual(observer.commits, 0)
+        self.assertEqual(req.resources, set())
+        self.assertEqual(adder.memory_budget.rem_state_slots, 9)
+
+    def test_exception_after_append_restores_membership_and_physical_lock(self):
+        c, observer, req, adder = self.make(mode="append_then_raise")
+        with self.assertRaises(P.PrefixAdmissionRejected):
+            c.admit(req, adder, False, None)
+        self.assertEqual(req.resources, set())
+        self.assertEqual(adder.can_run_list, [])
+        self.assertEqual(observer.reservations, set())
+
+    def test_partial_batch_allocation_rolls_back_all_requests(self):
+        c, observer, first, adder = self.make()
+        second = Request("second")
+        for req in (first, second):
+            c.admit(req, adder, False, None)
+        with self.assertRaisesRegex(RuntimeError, "batch allocation"):
+            c.build_batch(adder, lambda: Batch([first, second], fail=True))
+        self.assertEqual(first.resources | second.resources, set())
+        self.assertEqual(adder.can_run_list, [])
+        self.assertEqual(observer.reservations, set())
+
+    def test_batch_construction_failure_rolls_back_staged_match(self):
+        c, observer, req, adder = self.make()
+        c.admit(req, adder, False, None)
+        def fail_factory():
+            raise RuntimeError("batch init failed")
+        with self.assertRaisesRegex(RuntimeError, "batch construction"):
+            c.build_batch(adder, fail_factory)
+        self.assertEqual(req.resources, set())
+        self.assertEqual(observer.reservations, set())
+
+    def test_temporary_pressure_permits_only_one_fully_rolled_back_retry(self):
+        c, observer, req, adder = self.make(Observer(accepted=False))
+        self.assertEqual(c.admit(req, adder, False, None), Result.OTHER)
+        self.assertEqual((observer.prepares, observer.polls, observer.rollbacks), (2, 1, 2))
+        self.assertEqual(req.resources, set())
+
+    def test_preexisting_recurrent_state_is_preserved(self):
+        c, observer, req, adder = self.make(mode="no_membership")
+        req.kv.mamba_pool_idx = "existing-owned-state"
+        self.assertEqual(c.admit(req, adder, False, None), Result.OTHER)
+        self.assertEqual(req.kv.mamba_pool_idx, "existing-owned-state")
+        self.assertEqual(req.resources, set())
+
+    def run_two(self, operation):
+        group = CollectiveGroup()
+        replicas = []
+        for rank in range(2):
+            observer = Observer(rank=rank)
+            s, parallel = scheduler(observer, tp=2)
+            replicas.append((Coordinator(s, parallel, group, rank), observer, Request(), Adder()))
+        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
+            futures = [executor.submit(operation, rank, *replica) for rank, replica in enumerate(replicas)]
+            results = [future.result(timeout=8) for future in futures]
+        return replicas, results
+
+    def test_tp_match_disagreement_rolls_back_every_rank(self):
+        def run(rank, c, observer, req, adder):
+            req.match_len += rank
+            with self.assertRaises(P.PrefixAdmissionRejected):
+                c.admit(req, adder, False, None)
+        replicas, _ = self.run_two(run)
+        for c, observer, req, adder in replicas:
+            self.assertEqual(req.resources, set())
+            self.assertEqual(observer.prepares, 1)
+
+    def test_tp_reclaim_failure_prevents_all_ranks_from_retrying(self):
+        def run(rank, c, observer, req, adder):
+            observer.accepted = rank != 0
+            observer.fail_poll = rank == 0
+            with self.assertRaisesRegex(RuntimeError, "poll failed"):
+                c.admit(req, adder, False, None)
+        replicas, _ = self.run_two(run)
+        for c, observer, req, adder in replicas:
+            self.assertEqual((observer.prepares, observer.polls), (1, 1))
+            self.assertEqual(req.resources, set())
+            self.assertEqual(observer.reservations, set())
+
+    def test_tp_commit_finalizer_failure_keeps_entire_batch_rollbackable(self):
+        def run(rank, c, observer, req, adder):
+            c.admit(req, adder, False, None)
+            with self.assertRaisesRegex(RuntimeError, "native commit preparation"):
+                c.build_batch(adder, lambda: Batch([req], fail_finalizer=rank == 0))
+        replicas, _ = self.run_two(run)
+        for c, observer, req, adder in replicas:
+            self.assertEqual(req.resources, set())
+            self.assertEqual(adder.can_run_list, [])
+            self.assertEqual(observer.reservations, set())
+
+    def test_tp_plan_freeze_failure_releases_physically_allocated_batch(self):
+        def run(rank, c, observer, req, adder):
+            observer.fail_commit = rank == 1
+            c.admit(req, adder, False, None)
+            with self.assertRaisesRegex(RuntimeError, "prefix commit failed"):
+                c.build_batch(adder, lambda: Batch([req]))
+        replicas, _ = self.run_two(run)
+        for c, observer, req, adder in replicas:
+            self.assertEqual(req.resources, set())
+            self.assertEqual(observer.reservations, set())
+
+    def test_tp_ordinary_prepare_restoration_failure_cannot_return_early(self):
+        def run(rank, c, observer, req, adder):
+            observer.prepare = lambda *args: None
+            if rank == 0:
+                def fail(mark):
+                    raise RuntimeError("nested budget restore failed")
+                adder.memory_budget.restore_admission_checkpoint = fail
+            with self.assertRaises(P.AdmissionRollbackError):
+                c.admit(req, adder, False, None)
+        self.run_two(run)
+
+    def test_tp_rank_local_rollback_error_forbids_reclaim_retry(self):
+        def run(rank, c, observer, req, adder):
+            observer.accepted = False
+            if rank == 0:
+                def fail(*args):
+                    raise RuntimeError("plugin rollback failed")
+                observer.rollback = fail
+            with self.assertRaises(P.AdmissionRollbackError):
+                c.admit(req, adder, False, None)
+        replicas, _ = self.run_two(run)
+        for c, observer, req, adder in replicas:
+            self.assertEqual((observer.prepares, observer.polls), (1, 0))
+
+
+if __name__ == "__main__":
