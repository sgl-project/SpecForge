+def record_batch_token_allocation(batch, storage, token_ids):
+    """Receipt for newly allocated pages, excluding a borrowed prefix tail."""
+    receipts = [getattr(req, "_prefix_native_admission_receipt", None) for req in batch.reqs]
+    if not any(receipts):
+        return None
+    if not all(receipts):
+        raise RuntimeError("transactional and ordinary prefills cannot share allocations")
+    page_size = batch.token_to_kv_pool_allocator.page_size
+    segments, offset = [], 0
+    for prefix_len, extend_len in zip(batch.prefix_lens, batch.extend_lens):
+        borrowed = min(extend_len, (-prefix_len) % page_size)
+        if borrowed < extend_len:
+            segments.append(token_ids[offset + borrowed:offset + extend_len])
+        offset += extend_len
