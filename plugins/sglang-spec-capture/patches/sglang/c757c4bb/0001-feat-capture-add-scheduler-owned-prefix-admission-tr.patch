+def record_request_rows(table, rows, receipt):
+    """Record raw rows before generation updates, callbacks or Req binding."""
+    if receipt is None:
+        return
+    if not hasattr(table, "_prefix_admission_row_releases"):
+        table._prefix_admission_row_releases = {}
+    registry = table._prefix_admission_row_releases
+    for row in rows:
+        if row in registry:
+            raise RuntimeError("request row already has an admission owner")
+        def release(row=row):
+            registry.pop(row, None)
+            table._free_rows_without_admission([row])
+        registry[row] = receipt.record(
+            "request row", release, on_commit=lambda row=row: registry.pop(row, None)
+        )
