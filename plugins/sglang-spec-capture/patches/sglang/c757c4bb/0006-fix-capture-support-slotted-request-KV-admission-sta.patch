index 0000000000..491d5ed620
--- /dev/null
+++ b/test/registered/unit/managers/test_prefix_admission_actual_req.py
@@ -0,0 +1,162 @@
+"""Actual pinned Req/ReqKvInfo/budget CPU interface regression.
+
+Source method bodies and dataclass decorators are executed unchanged. Clock,
+mode enum and IPC leaves are small doubles; no model, CUDA or venv is loaded.
+This establishes the CPU boundary, not real scheduler/GPU acceptance.
+"""
+
+import ast
+import copy
+import dataclasses
+import importlib.util
+import logging
+import sys
+import types
+import unittest
+from array import array
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[4]
+SOURCE = ROOT / "python/sglang/srt"
+spec = importlib.util.spec_from_file_location(
+    "actual_req_prefix_admission", SOURCE / "managers/prefix_admission.py"
+)
+P = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = P
+spec.loader.exec_module(P)
+
+
+def extract(relative, names, namespace, methods=None):
+    source = ast.parse((SOURCE / relative).read_text())
+    selected = [node for node in source.body if isinstance(node, (ast.ClassDef, ast.FunctionDef)) and node.name in names]
+    if methods:
+        for cls in selected:
+            if isinstance(cls, ast.ClassDef) and cls.name in methods:
+                cls.body = [node for node in cls.body if isinstance(node, ast.FunctionDef) and node.name in methods[cls.name]]
+    body = [ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0), *selected]
+    exec(compile(ast.fix_missing_locations(ast.Module(body=body, type_ignores=[])), str(SOURCE / relative), "exec"), namespace)
+
+
+class ClockLeaf:
+    def __init__(self, **kwargs):
+        pass
+
+    def set_metrics_collector(self, value):
+        pass
+
+    def set_scheduler_recv_time(self):
+        pass
+
+
+def actual_namespace():
+    module = types.ModuleType("pinned_actual_req_methods")
+    sys.modules[module.__name__] = module
+    namespace = vars(module)
+    namespace.update(dataclasses=dataclasses, dataclass=dataclasses.dataclass,
+        array=array, copy=copy, SchedulerReqTimeStats=ClockLeaf,
+        CaptureHiddenMode=types.SimpleNamespace(NULL=0, FULL=1, LAST=2),
+        FAKE_BOOTSTRAP_HOST="fake", is_cp_sharded_padded=lambda: False)
+    extract("mem_cache/base_prefix_cache.py", {"CacheRequestHandle"}, namespace)
+    extract("dllm/mixin/req.py", {"ReqDllmMixin"}, namespace,
+        {"ReqDllmMixin": {"init_diffusion_llm", "is_dllm"}})
+    extract("managers/schedule_batch.py", {
+        "ReqKvInfo", "ReqLogprob", "Req", "BaseFinishReason", "FINISH_ABORT",
+        "get_return_hidden_states_mode",
+    }, namespace, {"Req": {"__init__", "refresh_fill_ids", "init_next_round_input",
+        "_compute_max_prefix_len", "needs_host_load_back", "auxiliary_swa_host_hit_length",
+        "finish_outside_step"}})
+    extract("mem_cache/prefill_budget.py", {"PrefillAdmissionCheckpoint", "PrefillBudget"}, namespace)
+    return namespace
+
+
+class ActualReqContracts(unittest.TestCase):
+    def setUp(self):
+        self.ns = actual_namespace()
+        self.req = self.ns["Req"](
+            "actual-req", None, array("q", [11, 22, 33, 44]),
+            types.SimpleNamespace(max_new_tokens=0, custom_params={}),
+            return_hidden_states=True,
+        )
+        self.budget = self.ns["PrefillBudget"](types.SimpleNamespace(page_size=1), None)
+        self.adder = types.SimpleNamespace(memory_budget=self.budget,
+            can_run_list=[], preempt_list=[], rem_input_tokens=100, rem_chunk_tokens=None)
+
+    def test_actual_slotted_req_kv_receipt_restores_metadata_and_resource_identity(self):
+        self.assertFalse(hasattr(self.req.kv, "__dict__"))
+        with self.assertRaises(TypeError):
+            vars(self.req.kv)  # The exact failed operation from the first smoke.
+        existing_tensor_handle = object()
+        self.req.kv.mamba_pool_idx = existing_tensor_handle
+        self.req.kv.component_evicted_seqlens["full"] = 7
+        self.req.kv.mamba_ping_pong_empty = [True, False]
+        before = self.budget.admission_checkpoint()
+        mark = P.NativeAdmissionReceipt(self.adder, self.req)
+        self.assertIs(mark.kv_before["mamba_pool_idx"], existing_tensor_handle)
+        self.assertIsNot(mark.kv_before["component_evicted_seqlens"], self.req.kv.component_evicted_seqlens)
+        self.req.kv.mamba_pool_idx = object()
+        self.req.kv.component_evicted_seqlens["full"] = 9
+        self.req.kv.mamba_ping_pong_empty[0] = False
+        self.budget.reserve(4, 2)
+        self.req.init_next_round_input(None, max_prefix_len=0)
+        mark.rollback()
+        self.assertIs(self.req.kv.mamba_pool_idx, existing_tensor_handle)
+        self.assertEqual(self.req.kv.component_evicted_seqlens, {"full": 7})
+        self.assertEqual(self.req.kv.mamba_ping_pong_empty, [True, False])
+        self.assertEqual(self.budget.admission_checkpoint(), before)
+        self.assertEqual(list(self.req.origin_input_ids), [11, 22, 33, 44])
+        self.assertEqual(list(self.req.full_untruncated_fill_ids), [])
+
+    def test_actual_req_can_prepare_commit_without_kv_dict(self):
+        mark = P.NativeAdmissionReceipt(self.adder, self.req)
+        self.req.init_next_round_input(None, max_prefix_len=0)
+        mark.prepare_commit()
+        mark.commit()
+        self.assertEqual(list(self.req.full_untruncated_fill_ids), [11, 22, 33, 44])
+        self.assertIsNone(self.req._prefix_native_admission_receipt)
+
+    def test_local_phase_logs_original_native_trace_before_tp_string_vote(self):
+        coordinator = P.PrefixAdmissionCoordinator(
+            types.SimpleNamespace(), parallel=types.SimpleNamespace(tp_size=1)
+        )
+        with self.assertLogs(P.__name__, level="WARNING") as logs:
+            _, errors = coordinator.phase(lambda: vars(self.req.kv))
+        self.assertIn("TypeError", errors[0])
+        self.assertIsNotNone(logs.records[0].exc_info)
+        self.assertIn("vars(self.req.kv)", "\n".join(logs.output))
+
+    def test_actual_scheduler_rejection_preserves_phase_status_and_trace(self):
+        namespace = self.ns
+        namespace.update(logger=logging.getLogger("actual_prefix_rejection"),
+            AbortReq=types.SimpleNamespace, PrefixAdmissionRejected=P.PrefixAdmissionRejected,
+            compute_weight_version_spans=lambda *args, **kwargs: [],
+            get_serving=lambda: types.SimpleNamespace(weight_version="default"))
+        for name in ("SchedulerDisaggregationDecodeMixin", "SchedulerDisaggregationPrefillMixin",
+            "SchedulerPPMixin", "SchedulerDllmMixin", "SchedulerMlxOverlapMixin"):
+            namespace[name] = type(name, (), {})
+        extract("managers/scheduler.py", {"Scheduler", "_make_abort_req"}, namespace,
+            {"Scheduler": {"_reject_prefix_admission"}})
+        scheduler = namespace["Scheduler"]()
+        scheduler.waiting_queue = [self.req]
+        released, sent = [], []
+        scheduler._release_aborted_request = lambda req: released.append(req)
+        scheduler.send_abort_output = lambda output, req: sent.append(output)
+        with self.assertLogs("actual_prefix_rejection", level="WARNING") as logs:
+            try:
+                raise TypeError("vars() argument must have __dict__ attribute")
+            except TypeError as native:
+                try:
+                    raise P.PrefixAdmissionRejected("TP prefix native receipt failed: TypeError: " + str(native)) from native
+                except P.PrefixAdmissionRejected as exc:
+                    scheduler._reject_prefix_admission(self.req, exc)
+        self.assertEqual(released, [self.req])
+        self.assertEqual(scheduler.waiting_queue, [])
+        self.assertEqual(sent[0].finished_reason, self.req.finished_reason.to_json())
+        self.assertEqual(sent[0].finished_reason["status_code"], 400)
+        self.assertIn("native receipt failed", sent[0].finished_reason["message"])
+        self.assertIn("__dict__", "\n".join(logs.output))
+        self.assertIsNotNone(logs.records[0].exc_info)
+
+
+if __name__ == "__main__":
+    unittest.main()
