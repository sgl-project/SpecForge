From 3735c9f6de75811b8051960627c934950be7f353 Mon Sep 17 00:00:00 2001
From: Wilbolu <wilbolu@outlook.com>
Date: Tue, 10 Nov 2026 02:16:00 +0800
Subject: [PATCH 3/6] fix(capture): fence cancelled plugin control replies

Keep the existing FIFO communicator task alive until its scheduler reply drains even after the HTTP waiter is cancelled, and reject replies with another control_id. This prevents an abandoned control response from being accepted by a later begin/cleanup call.

Validation: all 19 CPU admission/control contracts pass, including tests that execute the actual tokenizer method body with the actual FanOutCommunicator to force cancellation and a stale-generation reply. AST/diff checks passed. HTTP, real IPC and TP GPU integration remain independently pending.
---
 python/sglang/srt/managers/io_struct.py       |  2 +
 python/sglang/srt/managers/scheduler.py       |  3 +-
 .../srt/managers/tokenizer_control_mixin.py   | 19 +++++--
 .../unit/managers/test_prefix_admission.py    | 52 +++++++++++++++++++
 4 files changed, 72 insertions(+), 4 deletions(-)

diff --git a/python/sglang/srt/managers/io_struct.py b/python/sglang/srt/managers/io_struct.py
index 6efa1b882b..2ba6b8d950 100644
--- a/python/sglang/srt/managers/io_struct.py
+++ b/python/sglang/srt/managers/io_struct.py
@@ -2671,9 +2671,11 @@ class PluginControlReqInput(BaseReq, kw_only=True):
 
     namespace: str
     body: Dict[str, Any]
+    control_id: str
 
 
 class PluginControlReqOutput(BaseReq, kw_only=True):
+    control_id: str
     success: bool
     response: Dict[str, Any]
     error: str = ""
diff --git a/python/sglang/srt/managers/scheduler.py b/python/sglang/srt/managers/scheduler.py
index 6eebb91087..0e4805dd77 100644
--- a/python/sglang/srt/managers/scheduler.py
+++ b/python/sglang/srt/managers/scheduler.py
@@ -6770,10 +6770,11 @@ class Scheduler(
         response, errors = self.prefix_admission_coordinator.phase(dispatch)
         if any(error is not None for error in errors):
             result = PluginControlReqOutput(
-                success=False, response={}, error=repr(errors)
+                control_id=recv_req.control_id, success=False, response={}, error=repr(errors)
             )
         else:
             result = PluginControlReqOutput(
+                control_id=recv_req.control_id,
                 success=True,
                 response=self.prefix_admission_coordinator.broadcast(response),
             )
diff --git a/python/sglang/srt/managers/tokenizer_control_mixin.py b/python/sglang/srt/managers/tokenizer_control_mixin.py
index 41b83035b4..f8c3a208b0 100644
--- a/python/sglang/srt/managers/tokenizer_control_mixin.py
+++ b/python/sglang/srt/managers/tokenizer_control_mixin.py
@@ -192,9 +192,22 @@ class TokenizerControlMixin:
         if not namespace or not isinstance(body, dict):
             raise ValueError("plugin control requires a namespace and JSON object")
         self.auto_create_handle_loop()
-        results = await self.plugin_control_communicator(
-            PluginControlReqInput(namespace=namespace, body=body)
-        )
+        control_id = uuid.uuid4().hex
+        pending = asyncio.create_task(self.plugin_control_communicator(
+            PluginControlReqInput(namespace=namespace, body=body, control_id=control_id)
+        ))
+        # Keep the communicator's FIFO lock until its reply is drained even if
+        # the HTTP waiter disappears. A new caller cannot consume its late reply.
+        try:
+            results = await asyncio.shield(pending)
+        except asyncio.CancelledError:
+            def consume_cancelled_call(task):
+                if not task.cancelled():
+                    task.exception()
+            pending.add_done_callback(consume_cancelled_call)
+            raise
+        if any(result.control_id != control_id for result in results):
+            raise ValueError("stale plugin control response")
         errors = [result.error for result in results if not result.success]
         if errors:
             raise ValueError("; ".join(errors))
