+class PluginControlCancellationTests(unittest.IsolatedAsyncioTestCase):
+    def method(self):
+        # Execute the actual tokenizer method and real FanOutCommunicator;
+        # only IPC transport/messages are replaced by in-process callbacks.
+        source = ast.parse((SOURCE.parent / "tokenizer_control_mixin.py").read_text())
+        cls = next(node for node in source.body if isinstance(node, ast.ClassDef) and node.name == "TokenizerControlMixin")
+        method = next(node for node in cls.body if isinstance(node, ast.AsyncFunctionDef) and node.name == "plugin_control")
+        body = [ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0), method]
+        namespace = {"asyncio": asyncio, "uuid": uuid, "PluginControlReqInput": types.SimpleNamespace}
+        exec(compile(ast.fix_missing_locations(ast.Module(body=body, type_ignores=[])), "actual_tokenizer_plugin_control", "exec"), namespace)
+        spec = importlib.util.spec_from_file_location("actual_fanout", SOURCE.parent / "communicator.py")
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        return namespace["plugin_control"], module.FanOutCommunicator
+
+    async def test_cancelled_http_waiter_drains_reply_before_next_dispatch(self):
+        method, communicator_type = self.method()
+        sent = []
+        events = [asyncio.Event(), asyncio.Event()]
+        def send(obj):
+            sent.append(obj)
+            events[len(sent) - 1].set()
+        comm = communicator_type(send, 1)
+        tokenizer = types.SimpleNamespace(auto_create_handle_loop=lambda: None, plugin_control_communicator=comm)
+        first = asyncio.create_task(method(tokenizer, "plugin", {"attempt": "old"}))
+        await asyncio.wait_for(events[0].wait(), 1)
+        first.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await first
+        second = asyncio.create_task(method(tokenizer, "plugin", {"attempt": "new"}))
+        await asyncio.sleep(0)
+        self.assertEqual(len(sent), 1)
+        comm.handle_recv(types.SimpleNamespace(control_id=sent[0].control_id, success=True, response={"attempt": "old"}, error=""))
+        await asyncio.wait_for(events[1].wait(), 1)
+        comm.handle_recv(types.SimpleNamespace(control_id=sent[1].control_id, success=True, response={"attempt": "new"}, error=""))
+        self.assertEqual(await asyncio.wait_for(second, 1), {"attempt": "new"})
+
+    async def test_wrong_control_generation_is_rejected(self):
+        method, communicator_type = self.method()
+        event = asyncio.Event()
+        comm = communicator_type(lambda obj: event.set(), 1)
+        tokenizer = types.SimpleNamespace(auto_create_handle_loop=lambda: None, plugin_control_communicator=comm)
+        call = asyncio.create_task(method(tokenizer, "plugin", {}))
+        await asyncio.wait_for(event.wait(), 1)
+        comm.handle_recv(types.SimpleNamespace(control_id="stale", success=True, response={}, error=""))
+        with self.assertRaisesRegex(ValueError, "stale plugin control response"):
+            await asyncio.wait_for(call, 1)
+
+
 if __name__ == "__main__":
     unittest.main()
